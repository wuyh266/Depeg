# Copy to .env.docker. Use a different randomly generated hex string for each value.
DEPEG_MYSQL_PASSWORD=
DEPEG_MYSQL_ROOT_PASSWORD=
DEPEG_JWT_SIGNING_KEY=

# Email verification for new accounts. Use the provider's SMTP authorization code or SMTP password.
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=tls

DEPEG_PORT=8080
DEPEG_PYTHON_DIR=../Depeg-future

# Optional UTC minute for the first import, for example 2026-11-10T08:00:00Z.
# When blank, an empty database starts 10 minutes before the collector launches.
COLLECTOR_BOOTSTRAP_FROM=

# Optional HTTP proxy accessible from the collector container.
COLLECTOR_PROXY=
