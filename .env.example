# Copy using scripts/setup.ps1. Fill MYSQL_DSN before migration or API startup.
MYSQL_DSN=
# Example format (do not use a privileged account for a deployed API):
# MYSQL_DSN=depeg:your-password@tcp(127.0.0.1:3306)/depeg?charset=utf8mb4&parseTime=true&loc=UTC
JWT_SIGNING_KEY=
JWT_ISSUER=depeg-platform
JWT_AUDIENCE=depeg-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
# Email verification for new accounts. Use the provider's SMTP authorization code or SMTP password.
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=tls
HTTP_ADDRESS=127.0.0.1:8080
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
# Optional local MySQL container:
MYSQL_IMAGE=
MYSQL_DATABASE=depeg
MYSQL_USER=depeg
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
